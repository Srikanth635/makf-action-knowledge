{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/aicor/extraction-contract/v0.1/json-schema",
  "title": "makf_extraction_contract",
  "$ref": "#/$defs/ExtractionBatch",
  "$defs": {
    "ExtractionBatch": {
      "type": "object",
      "description": "A batch of provisional action-knowledge candidates with locally traceable source passages.",
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceDocument"
          },
          "minItems": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KnowledgeCandidate"
          },
          "minItems": 1
        },
        "extraction_run": {
          "$ref": "#/$defs/ExtractionRun"
        }
      },
      "required": [
        "batch_id",
        "profile_id",
        "documents",
        "candidates"
      ],
      "additionalProperties": false
    },
    "SourceDocument": {
      "type": "object",
      "description": "Source bibliographic metadata, not a world-model entity.",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "description": "Source link; optional because local-only sources are permitted."
        },
        "doi": {
          "type": "string",
          "description": "Optional DOI as cited in source metadata; never hallucinate."
        },
        "synthetic_demo": {
          "type": "boolean",
          "description": "True only for explicitly invented tests, not scientific evidence."
        },
        "passages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourcePassage"
          },
          "minItems": 1
        }
      },
      "required": [
        "document_id",
        "title",
        "synthetic_demo",
        "passages"
      ],
      "additionalProperties": false
    },
    "SourcePassage": {
      "type": "object",
      "description": "Exactly extracted text, whose quoted substrings can be checked.",
      "properties": {
        "passage_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "description": "Section, page, paragraph or text anchor if actually known."
        }
      },
      "required": [
        "passage_id",
        "text"
      ],
      "additionalProperties": false
    },
    "ExtractionRun": {
      "type": "object",
      "description": "Audit metadata for generation, not evidence of empirical truth.",
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. model, human-authored test, or import converter."
        },
        "model_name": {
          "type": "string",
          "description": "Model identifier if an LLM was used."
        },
        "prompt_version": {
          "type": "string",
          "description": "Extraction prompt/template revision if applicable."
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "description": "Optional execution timestamp; never invent."
        }
      },
      "required": [
        "engine"
      ],
      "additionalProperties": false
    },
    "KnowledgeCandidate": {
      "type": "object",
      "description": "Provisional knowledge ABOUT an action type, not an action occurrence.",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "action_class": {
          "type": "string",
          "minLength": 1,
          "description": "CURIE of an existing declared OWL action class, e.g. aicor:Pouring."
        },
        "frame_class": {
          "type": "string",
          "minLength": 1,
          "description": "CURIE of the MAKF action-specific knowledge frame OWL class."
        },
        "perspectives": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "role",
              "intentional",
              "causal",
              "temporal",
              "procedural",
              "observational",
              "epistemic",
              "applicability",
              "deviation"
            ]
          },
          "minItems": 1
        },
        "knowledge_kind": {
          "type": "string",
          "enum": [
            "definition",
            "stereotype",
            "conditional_principle",
            "strategy_description",
            "causal_hypothesis",
            "strategy_hypothesis",
            "temporal_pattern",
            "observation_expectation",
            "deviation_hypothesis"
          ],
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "Explicitly qualified generalized statement, not a world fact."
        },
        "modality": {
          "type": "string",
          "enum": [
            "necessary",
            "typical",
            "conditional",
            "possible",
            "speculative"
          ],
          "minLength": 1
        },
        "epistemic_status": {
          "type": "string",
          "enum": [
            "definition",
            "stereotype",
            "conditional_principle",
            "hypothesis",
            "proposed_strategy"
          ],
          "minLength": 1
        },
        "derivation_mode": {
          "type": "string",
          "enum": [
            "source_explicit",
            "source_paraphrase",
            "llm_inference",
            "llm_proposal"
          ],
          "minLength": 1
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "source_anchored",
            "not_assessed",
            "corroborated",
            "contradicted",
            "unsupported"
          ],
          "minLength": 1
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KnowledgeComponent"
          },
          "minItems": 1
        },
        "structural_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuralLink"
          }
        },
        "source_support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceSupport"
          },
          "minItems": 1
        },
        "reviewer_note": {
          "type": "string",
          "description": "Optional human review note; absence is not a validation failure."
        }
      },
      "required": [
        "candidate_id",
        "action_class",
        "frame_class",
        "perspectives",
        "knowledge_kind",
        "statement",
        "modality",
        "epistemic_status",
        "derivation_mode",
        "evidence_status",
        "components",
        "source_support"
      ],
      "additionalProperties": false
    },
    "KnowledgeComponent": {
      "type": "object",
      "description": "An abstract description component, never a named physical individual.",
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "component_kind": {
          "type": "string",
          "enum": [
            "hypothesis",
            "strategy",
            "applicability_condition",
            "predicted_effect",
            "role_pattern",
            "goal_pattern",
            "causal_mechanism",
            "phase_pattern",
            "observation_pattern",
            "deviation_pattern",
            "generic_description"
          ],
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "ontology_class": {
          "type": "string",
          "description": "Existing named OWL class CURIE. Required when grounding_status=grounded."
        },
        "grounding_status": {
          "type": "string",
          "enum": [
            "grounded",
            "needs_mapping"
          ],
          "minLength": 1
        },
        "grounding_note": {
          "type": "string",
          "description": "Required for provisional/unmapped components to explain why."
        }
      },
      "required": [
        "component_id",
        "component_kind",
        "description",
        "grounding_status"
      ],
      "additionalProperties": false
    },
    "StructuralLink": {
      "type": "object",
      "description": "A candidate structural OWL-object-property link between two abstract components.",
      "properties": {
        "subject_component": {
          "type": "string",
          "minLength": 1
        },
        "predicate_curie": {
          "type": "string",
          "minLength": 1,
          "description": "Existing declared MAKF object property CURIE in E1."
        },
        "object_component": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "subject_component",
        "predicate_curie",
        "object_component"
      ],
      "additionalProperties": false
    },
    "SourceSupport": {
      "type": "object",
      "description": "Exact quote and location; source attribution is NOT experimental validation.",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "passage_id": {
          "type": "string",
          "minLength": 1
        },
        "exact_quote": {
          "type": "string",
          "minLength": 1,
          "description": "Verbatim substring in passage.text, checked by the validator."
        },
        "support_role": {
          "type": "string",
          "enum": [
            "asserts_claim",
            "context_only",
            "contradicts_claim"
          ],
          "minLength": 1
        },
        "start_char": {
          "type": "integer"
        },
        "end_char": {
          "type": "integer"
        }
      },
      "required": [
        "document_id",
        "passage_id",
        "exact_quote",
        "support_role"
      ],
      "additionalProperties": false
    }
  }
}
