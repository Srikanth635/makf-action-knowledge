    <https://example.org/makf/data/passage/64cf4ba42d8b514d0534d51d653f53a5764df2b36bb7b1d95ff477f0405cc96a> a pub:Passage ;
        pub:document <https://example.org/makf/data/source/414a8a5541f93c8dfb676e46bb539e8c6e7602ea234f6a86662cd5726c8d3aa1> ;
        pub:locator "arXiv 2011.07215v2, Section 3, fluid model, PDF pages 3-3" ;
        pub:passageId "fluid-model" ;
        pub:text """Fluids can naturally be modeled in a particle system, as detailed in [42]; specifically, a constant
density constraint is applied to each particle to enforce the incompressibility of the fluid. For each
particle, the constant density constraint is based on the position of that particle, as well as the positions
of its neighboring particles.
""" .

