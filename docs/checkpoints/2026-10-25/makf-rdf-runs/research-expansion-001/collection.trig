<https://example.org/makf/data/sources-graph/84dc95e5aae87cd4ebe71c17d06e47248ce09b854616a3a995d6a17cecd13f69> {
    <https://example.org/makf/data/passage/9d5f7a94934987e2164aac50130df6313712ea29af9922e8e5b66f8b9762fc2f> a pub:Passage ;
