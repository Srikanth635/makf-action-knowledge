    <https://example.org/makf/data/evidence/639c62d07c4939487b0f5498e690435242c946d4c536e858c35a5c553e5a9a8c> a pub:EvidenceAnchor ;
        pub:document <https://example.org/makf/data/source/414a8a5541f93c8dfb676e46bb539e8c6e7602ea234f6a86662cd5726c8d3aa1> ;
        pub:exactQuote "reward is the fraction of water that is successfully poured into the target cup." ;
        pub:passage <https://example.org/makf/data/passage/a3a6f28080bc6d2962ddd979076560ebb5c10de18aca0e73d89181b6d056ff32> ;
