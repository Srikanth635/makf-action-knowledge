    <https://example.org/makf/data/quantitative/2a88d212473a1147e38dc986cb5cc8a2f14b9c8ec9736744c8164ee832cd83a5> a q:Artifact ;
        q:artifact_id "fluidlab-tables-3-4.txt" ;
