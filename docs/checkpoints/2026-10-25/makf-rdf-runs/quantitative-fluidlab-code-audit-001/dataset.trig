        q:recordJSON "{\"artifact_id\":\"code-excerpt-4\",\"locator\":\"https://github.com/zhouxian/FluidLab/blob/7295eb6ed7ee92b2be471fd30b432238577f28ce/fluidlab/fluidengine/bodies/bodies.py#L62\",\"sha256\":\"e4fc9ab441fd97f1158ddcbb991416d645bebc8c725db9a494f72ea430af169f\",\"text\":\"        if color is not None:\\n            body_color = color\\n        else:\\n            body_color = COLOR[material]\\n\\n        body_color = np.tile(body_color, [len(particles), 1])\\n        body_rho = np.full(len(particles), RHO[material] )\\n        body_material = np.full(len(particles), material)\\n        body_used = np.full(len(particles), used)\\n        body_id = np.full(len(particles), len(self.bodies))\\n\\n        # rotate\\n\"}" ;
        q:sha256 "e4fc9ab441fd97f1158ddcbb991416d645bebc8c725db9a494f72ea430af169f" ;
        q:text """        if color is not None:
            body_color = color
        else:
            body_color = COLOR[material]

        body_color = np.tile(body_color, [len(particles), 1])
        body_rho = np.full(len(particles), RHO[material] )
        body_material = np.full(len(particles), material)
        body_used = np.full(len(particles), used)
        body_id = np.full(len(particles), len(self.bodies))

        # rotate
""" .

