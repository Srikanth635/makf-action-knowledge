    <https://example.org/makf/data/quantitative/2279c77b6b42df771253ac16074ac6fd1d3e1996de5ec836b90f2684a7c2d947> a q:Artifact ;
        q:artifact_id "code-excerpt-3" ;
        q:locator "https://github.com/zhouxian/FluidLab/blob/7295eb6ed7ee92b2be471fd30b432238577f28ce/fluidlab/fluidengine/simulators/mpm_simulator.py#L20" ;
        q:recordJSON "{\"artifact_id\":\"code-excerpt-3\",\"locator\":\"https://github.com/zhouxian/FluidLab/blob/7295eb6ed7ee92b2be471fd30b432238577f28ce/fluidlab/fluidengine/simulators/mpm_simulator.py#L20\",\"sha256\":\"21f226bc9514bb05feff428ec35ad73665e9bfeae370f85d72ede34e75972387\",\"text\":\"\\n        self.n_grid              = int(64 * quality)\\n        self.dx                  = 1 / self.n_grid\\n        self.inv_dx              = float(self.n_grid)\\n        self.dt                  = 2e-4\\n        self.p_vol               = (self.dx * 0.5) ** 2\\n        self.res                 = (self.n_grid,) * self.dim\\n        self.max_substeps_local  = max_substeps_local\\n        self.max_substeps_global = max_substeps_global\\n        self.horizon             = horizon\\n        self.n_substeps          = int(2e-3 / self.dt)\\n        self.max_steps_local     = int(self.max_substeps_local / self.n_substeps)\\n\\n        assert self.n_substeps * self.horizon < self.max_substeps_global\\n        assert self.max_substeps_local % self.n_substeps == 0\\n\"}" ;
        q:sha256 "21f226bc9514bb05feff428ec35ad73665e9bfeae370f85d72ede34e75972387" ;
        q:text """
        self.n_grid              = int(64 * quality)
        self.dx                  = 1 / self.n_grid
        self.inv_dx              = float(self.n_grid)
        self.dt                  = 2e-4
        self.p_vol               = (self.dx * 0.5) ** 2
        self.res                 = (self.n_grid,) * self.dim
        self.max_substeps_local  = max_substeps_local
        self.max_substeps_global = max_substeps_global
        self.horizon             = horizon
        self.n_substeps          = int(2e-3 / self.dt)
        self.max_steps_local     = int(self.max_substeps_local / self.n_substeps)

        assert self.n_substeps * self.horizon < self.max_substeps_global
        assert self.max_substeps_local % self.n_substeps == 0
""" .

